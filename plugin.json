{
  "schemaVersion": 1,
  "id": "netease",
  "name": "网易云音乐",
  "version": "0.4.7",
  "apiVersion": "1.0",
  "minHostVersion": "1.4.0",
  "entry": "src/main.js",
  "publisher": "TIMER-err",
  "capabilities": [
    "searchSongs",
    "searchAlbums",
    "searchArtists",
    "hotSearch",
    "home",
    "songDetails",
    "playlistDetails",
    "artistDetails",
    "albumDetails",
    "recent",
    "resolveStream",
    "lyrics",
    "account",
    "userPlaylists",
    "scrobble",
    "like",
    "playlistMutation",
    "heartRecommendation",
    "share",
    "login"
  ],
  "permissions": [
    "network",
    "clearTextNetwork",
    "credentials",
    "webAuth",
    "clipboard",
    "playbackRead",
    "playbackControl",
    "queueWrite",
    "notifications",
    "customUi",
    "backgroundTimers"
  ],
  "networkDomains": [
    "music.163.com",
    "interfacepc.music.163.com",
    "interface.music.163.com",
    "interface3.music.163.com",
    "clientlog.music.163.com",
    "ac.dun.163yun.com",
    "amlldb.bikonoo.com",
    "music.126.net",
    "*.music.126.net",
    "music-api.gdstudio.xyz",
    "search.kuwo.cn",
    "mobi.kuwo.cn",
    "bd-api.kuwo.cn",
    "*.kuwo.cn"
  ],
  "networkMethods": [
    "GET",
    "POST"
  ],
  "ui": [
    {
      "id": "listen-together",
      "placement": "playerAction",
      "label": "一起听",
      "icon": "group"
    },
    {
      "id": "unblock",
      "placement": "settings",
      "label": "音源解锁",
      "icon": "lock_open"
    }
  ]
}
